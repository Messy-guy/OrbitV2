{
  "expo": {
    "name": "Orbit Mobile",
    "slug": "orbit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.useorbit.mobile"
    },
    "android": {
      "package": "dev.useorbit.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B0E"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Orbit Mobile to access your camera to scan desktop pairing QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0B0E"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05d5dc95-fe6a-483f-8c31-c35bdd0bc114"
      }
    }
  }
}
